# Hermes Memory Plugin Environment Variables
# Copy this file to .env and modify the values as needed

# Required: API Key for the LLM service
MODEL_API_KEY=your_api_key_here

# Optional: Model configuration (defaults shown)
MODEL_NAME=deepseek-v3.2
MODEL_BASE_URL=https://api.lkeap.cloud.tencent.com/v1
MODEL_PROVIDER=custom

# Optional: Gateway configuration
TDAI_GATEWAY_PORT=8420
TDAI_GATEWAY_HOST=0.0.0.0

# Optional: Plugin connection settings
MEMORY_TENCENTDB_GATEWAY_HOST=127.0.0.1
MEMORY_TENCENTDB_GATEWAY_PORT=8420